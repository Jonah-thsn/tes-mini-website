{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Schema for agents.json",
  "type": "array",
  "minItems": 10,
  "maxItems": 10,
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "slug": {
        "type": "string"
      }
    },
    "required": [
      "name",
      "role",
      "slug"
    ]
  }
}
